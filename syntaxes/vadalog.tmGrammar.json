{
  "scopeName": "source.vadalog",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#parameters"
    },
    {
      "include": "#annotations"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#predicates"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation",
          "begin": "(%%\\s)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment"
            }
          },
          "end": "$",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.comment"
            }
          }
        },
        {
          "name": "comment.block",
          "begin": "(%\\*)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment"
            }
          },
          "end": "(\\*%)",
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.comment"
            }
          }
        },
        {
          "name": "comment.line",
          "begin": "(%)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment"
            }
          },
          "end": "(?=$)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vadalog",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.vadalog",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "meta.annotation.vadalog",
          "match": "(@)([A-Za-z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.annotation.vadalog"
            },
            "2": {
              "name": "keyword.other.annotation.vadalog"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.anonymous.vadalog",
          "match": "\\b_\\b"
        },
        {
          "name": "variable.other.vadalog",
          "match": "(?<![A-Za-z0-9_])_?[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "predicates": {
      "patterns": [
        {
          "name": "entity.name.function.vadalog",
          "match": "(?<![A-Za-z0-9_])([a-z][A-Za-z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.vadalog",
          "match": "(?::-|<-|==|!=|<>|<=|>=|&&|\\|\\||=|<|>|\\+|-|\\*|/|\\|\\b)"
        },
        {
          "name": "keyword.operator.logical.vadalog",
          "match": "\\b(?:and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.numeric.vadalog",
          "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?(?:[Ee]-?\\d+)?f?(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.other.date.vadalog",
          "match": "\\b\\d{4}-\\d{2}-\\d{2}(?:\\s+\\d{2}:\\d{2}:\\d{2})?\\b"
        },
        {
          "name": "constant.language.boolean.vadalog",
          "match": "(?<![A-Za-z0-9_])#(?:T|F)\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.vadalog",
          "match": ","
        },
        {
          "name": "punctuation.section.parens.begin.vadalog",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.vadalog",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.braces.begin.vadalog",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.vadalog",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.vadalog",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.vadalog",
          "match": "\\]"
        },
        {
          "name": "punctuation.terminator.vadalog",
          "match": "\\.(?=\\s*(?:%|$))"
        }
      ]
    },
    "parameters": {
      "patterns": [
        {
          "name": "variable.parameter.vadalog",
          "match": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
        }
      ]
    }
  },
  "name": "Vadalog"
}