{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "../out/tsc",
    "rootDir": "..",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src", "../parser/src"]
}
